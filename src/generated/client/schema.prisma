generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}

model Flight {
  id            String   @id @default(uuid())
  number        String   @unique
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime

  // Advanced Lifecycle States
  status String @default("SCHEDULED") // SCHEDULED, AI_OPTIMIZING, ASSIGNED, IN_FLIGHT, LANDED, DOCKING, BOARDING, READY_PUSHBACK, DEPARTED

  // Intelligence & Authority
  priority    String  @default("NORMAL") // NORMAL, VIP, EMERGENCY
  isEmergency Boolean @default(false)

  // Ground Truth (Source of Truth)
  groundState String? // CLEANING, REFUELING, BOARDING, COMPLETE

  gateId String?
  gate   Gate?   @relation(fields: [gateId], references: [id])

  passengers Passenger[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Gate {
  id       String @id @default(uuid())
  name     String @unique
  terminal String
  status   String @default("OPEN") // OPEN, CLOSED, MAINTENANCE, EMERGENCY_ONLY

  flights   Flight[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Passenger {
  id    String  @id @default(uuid())
  name  String
  email String  @unique
  seat  String?

  flightId String
  flight   Flight @relation(fields: [flightId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Staff {
  id        String   @id @default(uuid())
  name      String
  role      String // ADMIN, PILOT, GROUND_CREW, AI_OPERATOR
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
