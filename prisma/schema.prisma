generator client {
  provider = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum FlightStatus {
  SCHEDULED
  AI_OPTIMIZING
  ASSIGNED
  BOARDING
  READY_PUSHBACK
  IN_FLIGHT
  LANDED
  DOCKING
  DEPARTED
}

enum PriorityLevel {
  NORMAL
  VIP
  EMERGENCY
}

enum GroundState {
  CLEANING
  REFUELING
  BOARDING
  COMPLETE
}

enum AuditSeverity {
  INFO
  WARNING
  CRITICAL
}

enum SuggestionStatus {
  PENDING
  APPROVED
  EXPIRED
  REJECTED
}

enum GateStatus {
  OPEN
  CLOSED
  MAINTENANCE
  EMERGENCY_ONLY
}

enum GateType {
  DOMESTIC
  INTERNATIONAL
  CARGO
}

enum GateSize {
  SMALL
  MEDIUM
  LARGE
  HEAVY
}

model Flight {
  id            String   @id @default(uuid())
  number        String   @unique
  airline       String   @default("SkyLink")
  aircraftType  String   @default("Boeing 737")
  origin        String
  destination   String
  departureTime DateTime
  arrivalTime   DateTime
  
  // Advanced Lifecycle States
  status        FlightStatus   @default(SCHEDULED)
  
  // Intelligence & Authority
  priority      PriorityLevel  @default(NORMAL)
  isEmergency   Boolean        @default(false)
  impactScore   Int            @default(10)          // 0-100 score for AI prioritization
  
  // Temporal Awareness
  lastOptimizedAt DateTime?
  
  // Ground Truth (Source of Truth)
  groundState   GroundState?
  
  gateId        String?
  gate          Gate?    @relation(fields: [gateId], references: [id])
  
  suggestions   AiSuggestion[]
  milestones    FlightMilestone[]
  auditLogs     AiAuditLog[]
  passengers    Passenger[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Gate {
  id              String         @id @default(uuid())
  name            String         @unique
  terminal        String         @default("T1")
  zone            String         @default("NORTH") // NORTH, SOUTH, INTERNATIONAL
  type            GateType       @default(DOMESTIC)
  size            GateSize       @default(MEDIUM)
  status          GateStatus     @default(OPEN)
  isVip           Boolean        @default(false)
  
  // Spatial Data for Simulation
  mapX            Float          @default(0)
  mapY            Float          @default(0)
  taxiTime        Int            @default(5) // Minutes from runway
  adjacentGateIds String[]       @default([]) // Gates that might conflict physically
  
  flights         Flight[]
  
  // Two-way relations for re-evaluations
  newSuggestions AiSuggestion[] @relation("NewGate")
  oldSuggestions AiSuggestion[] @relation("OldGate")

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model AiSuggestion {
  id            String   @id @default(uuid())
  flightId      String
  flight        Flight   @relation(fields: [flightId], references: [id])
  
  oldGateId     String?
  oldGate       Gate?    @relation("OldGate", fields: [oldGateId], references: [id])
  
  newGateId     String
  newGate       Gate     @relation("NewGate", fields: [newGateId], references: [id])
  
  reason        String
  status        SuggestionStatus @default(PENDING)
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AiAuditLog {
  id              String        @id @default(uuid())
  flightId        String
  flight          Flight        @relation(fields: [flightId], references: [id])
  action          String        // OPTIMIZATION, CONFLICT_DETECTED, EMERGENCY_CASCADE
  message         String
  severity        AuditSeverity @default(INFO)
  confidenceScore Float         @default(1.0)
  createdAt       DateTime      @default(now())
}

model FlightMilestone {
  id          String   @id @default(uuid())
  flightId    String
  flight      Flight   @relation(fields: [flightId], references: [id])
  state       String   // The state reached (kept flexible as string)
  order       Int      @default(0)
  triggeredBy String   @default("SYSTEM") // AI, ADMIN, GROUND_STAFF
  timestamp   DateTime @default(now())
}

model Passenger {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  seat      String?
  
  flightId  String
  flight    Flight   @relation(fields: [flightId], references: [id])
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("GROUND_CREW") // ADMIN, GROUND_CREW, etc.
  password      String?   // For Credentials provider
  accounts      Account[]
  sessions      Session[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                 String  @id @default(uuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
